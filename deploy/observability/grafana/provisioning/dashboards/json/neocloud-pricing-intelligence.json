{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "GPU Pricing by Model: On-Demand vs Spot ($/hr)",
      "description": "Cross-provider hourly GPU cost comparison across on-demand and spot auction markets without long-term commitment.",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2.0 },
              { "color": "red", "value": 5.0 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "neocloud_gpu_hourly_price_usd",
          "legendFormat": "{{provider}} - {{chip}} ({{pricing_model}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "GPU Real-Time Obtainability & Availability Score",
      "description": "Provider hardware obtainability score (0.0 to 1.0) and inventory status.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "neocloud_gpu_obtainability_score",
          "legendFormat": "{{provider}} ({{chip}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Token Factory & Serverless: Input vs Output Cost / 1M Tokens",
      "description": "Open models Token Factory MaaS inference pricing comparison.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "neocloud_model_token_price_per_million_usd",
          "legendFormat": "{{provider}} - {{model}} ({{token_type}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pricing History Drift & Provider Sync Frequency",
      "description": "Monitors catalog update frequency (Vast.ai 5m dynamic bids, RunPod 1h shifts, Baseten scheduled).",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue", "value": 3600 },
              { "color": "purple", "value": 86400 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "neocloud_pricing_sync_interval_seconds",
          "legendFormat": "{{provider}} sync cadence",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["finops", "neocloud", "pricing", "gpu", "token-factory"],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Neocloud & FinOps Pricing Intelligence",
  "uid": "neocloud-pricing-intelligence",
  "version": 1
