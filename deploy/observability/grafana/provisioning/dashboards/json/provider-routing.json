{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Provider Execution Mode (Mock vs Live Environment)",
      "description": "Visualizes whether inference provider environments are executing against live remote APIs/CUDA or mocked offline environments.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "LIVE (Cloud / CUDA)", "color": "green" },
                "1": { "text": "MOCKED (Offline Dev)", "color": "orange" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "provider_is_mock",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Provider Health Status",
      "description": "Real-time health status of configured inference providers (1 = Healthy, 0 = Unhealthy).",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DEGRADED / DOWN", "color": "red" },
                "1": { "text": "HEALTHY", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "provider_health_status",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provider Routing Decisions & Cloud Spillovers",
      "description": "Deterministic provider routing evaluations and spillover count triggered by queue backlog or SLO risk.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "thresholdsStyle": { "mode": "dashed" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (provider, decision_code) (rate(provider_routing_decisions_total[1m]))",
          "legendFormat": "{{provider}} ({{decision_code}})",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (rate(provider_routing_spillover_total[1m]))",
          "legendFormat": "Spillover: {{provider}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Provider Gross Margin Ratio",
      "description": "Gross margin ratio per provider routing decision to ensure financial sustainability.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "green", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "provider_gross_margin_ratio",
          "legendFormat": "{{provider}} margin",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["inference", "observability", "m08", "routing", "providers"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "Multi-Tenant AI Inference - Provider Routing & Environments",
  "uid": "platform-provider-routing",
  "version": 1
}

