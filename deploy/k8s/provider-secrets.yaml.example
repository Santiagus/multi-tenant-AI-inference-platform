# ==============================================================================
# Kubernetes Secret Template: External Neocloud & AI Provider Credentials
# ==============================================================================
# Usage:
#   1. Replace placeholder values with your real API keys or generate via
#      External Secrets Operator (ESO) syncing from AWS Secrets Manager / Vault.
#   2. Apply to the cluster:
#        kubectl apply -f provider-secrets.yaml
#
# IMPORTANT:
#   NEVER commit this file with real secret keys populated!
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: platform-provider-secrets
  namespace: inference-workers
  labels:
    app.kubernetes.io/part-of: multi-tenant-ai-inference-platform
    app.kubernetes.io/component: inference-worker
type: Opaque
stringData:
  # RunPod Serverless / Pod API Credentials
  runpod-api-key: "PLACEHOLDER_RUNPOD_API_KEY"
  runpod-endpoint-id: "PLACEHOLDER_RUNPOD_ENDPOINT_ID"

  # Modal Serverless Credentials (Optional)
  modal-token-id: "PLACEHOLDER_MODAL_TOKEN_ID"
  modal-token-secret: "PLACEHOLDER_MODAL_TOKEN_SECRET"

  # Baseten Credentials (Optional)
  baseten-api-key: "PLACEHOLDER_BASETEN_API_KEY"

  # Vast.ai Credentials (Optional)
  vast-api-key: "PLACEHOLDER_VAST_API_KEY"

