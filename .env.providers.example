# ==============================================================================
# Inference Provider Environment Configuration
# Reference template for live cloud and local inference provider adapters.
# Keep real secrets in secret managers; do not commit filled credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Global Provider Mock Mode Flag
# ------------------------------------------------------------------------------
# Unique global flag for all external cloud providers:
# - MOCK_PROVIDERS=1: Offline simulation (zero cloud cost, realistic latencies).
# - MOCK_PROVIDERS=0: Live remote calls via configured keys & BASE_URLs.
# (Note: Local PyTorch CUDA / RTX 5070 Ti always executes live on local hardware).
# Automated testing strictly enforces MOCK_PROVIDERS=1.
MOCK_PROVIDERS=1

# ------------------------------------------------------------------------------
# 1. Local PyTorch / CUDA Engine
# ------------------------------------------------------------------------------
# Local hardware (RTX 5070 Ti / CPU) is auto-detected. Request calls can specify
# routing_preference ('local/gpu', 'local/cpu', 'cloud') or parameters.device.
LOCAL_INFERENCE_URL=http://localhost:8000/v1

# ------------------------------------------------------------------------------
# 2. RunPod Serverless GPU
# ------------------------------------------------------------------------------
RUNPOD_API_KEY=rpa_your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id
RUNPOD_BASE_URL=https://api.runpod.ai/v2
RUNPOD_MCP_URL=https://mcp.runpod.io/

# ------------------------------------------------------------------------------
# 3. AWS Bedrock (Foundation Models / Converse API)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS credentials (or use IAM Roles / IRSA in Kubernetes / ECS)
AWS_ACCESS_KEY_ID=AKIA_MOCK_KEY_ID
AWS_SECRET_ACCESS_KEY=mock_secret_access_key
# Default foundation model (e.g. Claude 3, Llama 3 70B, Titan)
BEDROCK_DEFAULT_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# ------------------------------------------------------------------------------
# 4. AWS SageMaker (Dedicated / Async Real-Time Endpoints)
# ------------------------------------------------------------------------------
SAGEMAKER_ENDPOINT_NAME=sagemaker-llama3-70b-instruct
SAGEMAKER_BASE_URL=https://runtime.sagemaker.us-east-1.amazonaws.com

# ------------------------------------------------------------------------------
# 5. Modal Serverless GPU (Scale-to-Zero Python Engine)
# ------------------------------------------------------------------------------
MODAL_TOKEN_ID=ak_mock_modal_token_id
MODAL_TOKEN_SECRET=as_mock_modal_token_secret
MODAL_PROFILE=default
MODAL_APP_NAME=inference-platform-service
MODAL_BASE_URL=https://api.modal.com

# ------------------------------------------------------------------------------
# 6. Baseten Serverless GPU (Truss / vLLM Endpoints)
# ------------------------------------------------------------------------------
BASETEN_API_KEY=mock_baseten_api_key
BASETEN_MODEL_ID=mock_baseten_model_id
BASETEN_BASE_URL=https://bridge.baseten.co/v1
BASETEN_MCP_URL=https://api.baseten.co/mcp

# ------------------------------------------------------------------------------
# 7. Nebius (European Sovereign AI & Compute)
# ------------------------------------------------------------------------------
# Path A: Nebius AI Studio / Token Factory (Shared Token API for Open Models)
NEBIUS_API_KEY=mock_nebius_studio_api_key
NEBIUS_STUDIO_BASE_URL=https://api.studio.nebius.ai/v1

# Path B: Nebius AI Cloud (Dedicated Endpoints & Custom Containers for Owned Models)
NEBIUS_ENDPOINT_URL=https://your-endpoint-id.ai.nebius.cloud
NEBIUS_ENDPOINT_TOKEN=mock_custom_bearer_token
NEBIUS_PARENT_ID=aiproject-mock-id
NEBIUS_TENANT_ID=tenant-mock-id

# ------------------------------------------------------------------------------
# 8. Vast.ai Spot / Preemptible Fleet (Cheapest Consumer GPU Marketplace)
# ------------------------------------------------------------------------------
VAST_API_KEY=mock_vast_api_key
VAST_BASE_URL=https://console.vast.ai/api/v0

# ------------------------------------------------------------------------------
# 9. Runware Serverless / Fast Inference Engine
# ------------------------------------------------------------------------------
RUNWARE_API_KEY=mock_runware_api_key
RUNWARE_BASE_URL=https://api.runware.ai/v1

# ------------------------------------------------------------------------------
# 10. CoreWeave Forge (Serverless Inference & Sandboxes)
# ------------------------------------------------------------------------------
COREWEAVE_FORGE_API_KEY=mock_coreweave_api_key
COREWEAVE_FORGE_BASE_URL=https://api.inference.wandb.ai/v1

# ------------------------------------------------------------------------------
# 11. Weights & Biases (Weave Tracing, Model Registry & Agent Evaluations)
# ------------------------------------------------------------------------------
WANDB_API_KEY=mock_wandb_api_key
WANDB_ENTITY=mock-entity
WANDB_PROJECT=inference
WANDB_BASE_URL=https://api.wandb.ai
WANDB_MCP_URL=https://mcp.withwandb.com/mcp

# ------------------------------------------------------------------------------
# 12. fal.ai (Fast Serverless Media & Diffusion Inference)
# ------------------------------------------------------------------------------
FAL_KEY=mock_fal_key
FAL_BASE_URL=https://rest.alpha.fal.ai
FAL_MCP_URL=https://mcp.fal.ai/mcp-relay

# ------------------------------------------------------------------------------
# 13. JarvisLabs (GPU Cloud, Token Factory & Serverless Endpoints)
# ------------------------------------------------------------------------------
JL_API_KEY=mock_jarvislabs_api_key
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1

# ------------------------------------------------------------------------------
# 14. Beam Cloud (Serverless GPU Functions, Web Services & Endpoints)
# ------------------------------------------------------------------------------
BEAM_TOKEN=mock_beam_token
BEAM_BASE_URL=https://api.beam.cloud/v1

# ------------------------------------------------------------------------------
# 15. Hivenet (Distributed GPU Cloud & Managed Inference Service)
# ------------------------------------------------------------------------------
HIVENET_API_KEY=mock_hivenet_api_key
HIVENET_COMPUTE_BASE_URL=https://api.hivecompute.ai/v1
HIVENET_INFERENCE_BASE_URL=https://your-deployment-subdomain.hivenet.com/v1

# ------------------------------------------------------------------------------
# 16. WaveSpeed AI (Serverless Multi-Modal & Foundation Model Inference Gateway)
# ------------------------------------------------------------------------------
WAVESPEED_API_KEY=mock_wavespeed_api_key
WAVESPEED_BASE_URL=https://api.wavespeed.ai

# ------------------------------------------------------------------------------
# 17. NeoCloudz (Decentralized GPU Cloud & OpenAI-Compatible Inference Gateway)
# ------------------------------------------------------------------------------
NEOCLOUDZ_API_KEY=mock_neocloudz_jwt_token
NEOCLOUDZ_BASE_URL=https://console.neocloudz.com/gateway/v1
