{
  "name": "multi-tenant-ai-inference-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "db:seed:showcase": "pnpm --filter @platform/api run db:seed:showcase",
    "db:seed:showcase:clear": "pnpm --filter @platform/api run db:seed:showcase:clear",
    "sync:providers": "pnpm --filter @platform/api run sync:providers"
  }
}
