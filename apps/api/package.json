{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/infrastructure/db/migrations dist/infrastructure/db/migrations",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.660.0",
    "@aws-sdk/client-sqs": "^3.660.0",
    "@aws-sdk/s3-request-presigner": "^3.660.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "fastify": "^4.28.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
